# Scalekit credentials (from your Scalekit workspace dashboard)
SCALEKIT_ENV_URL=https://your-workspace.scalekit.dev
SCALEKIT_CLIENT_ID=skc_...
SCALEKIT_CLIENT_SECRET=test_...

# Your identity per connector -- used as the "identifier" for each connected account.
# These are usually the RevOps analyst's own email, but can differ per connector
# if you authorize with a shared service account for Salesforce/HubSpot/Sheets.
SALESFORCE_USER=analyst@yourcompany.com
HUBSPOT_USER=analyst@yourcompany.com
SLACK_USER=analyst@yourcompany.com
GOOGLE_SHEETS_USER=analyst@yourcompany.com

# Connector names -- these are only used for the Step 0 auth-check
# (get_or_create_connected_account) AND to disambiguate execute_tool() calls
# when one identifier is connected to multiple connectors of the same
# provider type. Must match the EXACT connection name shown in your Scalekit
# dashboard under Agent Auth > Connections. Scalekit often auto-suffixes these
# per workspace (e.g. "salesforce-1", "googlesheets-BOzvgKS0") -- copy the
# name shown for YOUR connection, the defaults below are unlikely to match
# another workspace exactly.
SALESFORCE_CONNECTOR=salesforce-1

# Plain REST HubSpot connector. Note: a separate HUBSPOTMCP connector variant
# also exists in Scalekit's tool catalog, but this agent is built against
# whichever variant is actually ACTIVE in your workspace -- verify with
# list_connected_accounts before assuming HUBSPOTMCP works for you.
HUBSPOT_CONNECTOR=hubspot

# SlackMCP connector name as configured in Scalekit -- copy the exact name
# shown in your dashboard (e.g. "slackmcp"). The plain "SLACK" connector
# variant commonly sits in PENDING_AUTH and is not used by this agent.
SLACK_CONNECTOR=slackmcp

# Google Sheets connector name as configured in Scalekit (e.g. "googlesheets-BOzvgKS0").
GOOGLE_SHEETS_CONNECTOR=googlesheets-BOzvgKS0

# The analyst this cycle is labeled under (shown in commentary and the
# Google Sheets log, and used as the state key for Slack change-detection).
# Pipeline queries themselves are org-wide, not scoped to a single owner --
# see aggregator.py.
ANALYST_EMAIL=analyst@yourcompany.com

# Display label for this forecast cycle, e.g. "2026-W30" or "Q3 2026", shown
# in commentary and the Sheets log. If left blank, defaults to the current
# ISO week (YYYY-Www). This is a label only -- it does NOT control whether
# Slack gets a post. Slack posting is gated by whether the pipeline content
# itself (deal counts, values, at-risk flags) has changed since the last
# post for this analyst, so the agent can run continuously (POLLING_MODE)
# and only posts when something actually moves. See state.py.
FORECAST_PERIOD=

# Slack destination -- a channel name (resolved via slackmcp_slack_search_channels)
# or a literal channel/user ID (C..., D..., G..., U...) to post to directly.
SLACK_CHANNEL=#revenue-ops

# Google Sheets destination -- the spreadsheet must already exist (create one
# manually at sheets.google.com, or once via googlesheets_create_spreadsheet).
# The tab/sheet name below is auto-created inside it if missing.
GOOGLE_SHEETS_SPREADSHEET_ID=...
GOOGLE_SHEETS_TAB_NAME=Forecast Log

# Pipeline coverage below this multiple of quota is flagged "at risk" overall.
# 3x is a common SaaS sales-planning rule of thumb assuming a 20-35% win rate.
COVERAGE_RATIO_TARGET=3.0

# Quota this cycle's total open pipeline is measured against, same currency
# units as the Amount/amount fields returned by Salesforce/HubSpot.
QUOTA_TARGET=100000

# A deal/opportunity whose CloseDate is more than this many days in the past
# while still open contributes to the "stale" at-risk signal (see aggregator.py).
STALE_DEAL_DAYS=90

# Timing
POLLING_MODE=false
POLL_INTERVAL_MINUTES=10080

# Logging
LOG_LEVEL=INFO

# LLM polish pass via OpenRouter (optional, falls back to the deterministic
# rule-based commentary if missing or if the call fails). The LLM never
# invents numbers -- it only rewrites the rule-based draft's exact figures
# more fluently for Slack.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini
