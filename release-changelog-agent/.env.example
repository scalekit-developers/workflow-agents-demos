# Scalekit credentials (from your Scalekit workspace dashboard)
SCALEKIT_ENV_URL=https://your-workspace.scalekit.dev
SCALEKIT_CLIENT_ID=skc_...
SCALEKIT_CLIENT_SECRET=test_...

# Your identity per connector -- used as the "identifier" for each connected
# account. Usually the release manager's own email.
GITHUB_USER=release@yourcompany.com
LINEAR_USER=release@yourcompany.com
CONFLUENCE_USER=release@yourcompany.com
NOTION_USER=release@yourcompany.com

# Connector names -- used for the Step 0 auth check AND to disambiguate
# execute_tool() calls when one identifier is connected to multiple connectors
# of the same provider type. Must match the EXACT connection name shown in your
# Scalekit dashboard under Agent Auth > Connections. Scalekit auto-suffixes
# these per workspace (e.g. "github-g0DJbhbx", "confluence-zXIthl0L"), so the
# generic provider labels usually will NOT work. List yours with
# list_connected_accounts.
GITHUB_CONNECTOR=github-g0DJbhbx

# Plain REST Linear connector (GraphQL under the hood). A LINEARMCP variant
# also exists in Scalekit's catalog with a different toolset; this agent is
# built against the plain LINEAR connector's linear_issue_get.
LINEAR_CONNECTOR=linear-wuvcVfMm

CONFLUENCE_CONNECTOR=confluence-zXIthl0L

# Plain REST Notion connector. A NOTIONMCP variant also exists with
# higher-level tools; this agent uses the REST one so it can emit raw Notion
# blocks with inline links.
NOTION_CONNECTOR=notion

# The release manager this changelog is attributed to (shown in the footer of
# the published page).
RELEASE_MANAGER=release@yourcompany.com

# Source repository.
GITHUB_OWNER=your-org
GITHUB_REPO=your-service

# The release being written up.
#   RELEASE_VERSION - the label that titles the changelog (e.g. "v2.4.0").
#                     Defaults to CURRENT_TAG when left blank.
#   PREVIOUS_TAG / CURRENT_TAG - bound the commit range.
# Leave all three blank and the agent uses the two most recent tags, i.e.
# "what shipped in the latest tag". Set CURRENT_TAG alone and the previous tag
# is the next one down the list. See provisioning.resolve_release_range.
RELEASE_VERSION=
PREVIOUS_TAG=
CURRENT_TAG=

# Confluence destination. CONFLUENCE_SPACE_KEY is the human key from the space
# URL (e.g. "SD"); the agent resolves it to the numeric spaceId the API needs.
# CONFLUENCE_PARENT_ID is optional -- set it to nest the changelog under an
# existing page instead of at the space root.
CONFLUENCE_SPACE_KEY=SD
CONFLUENCE_PARENT_ID=

# Notion destination -- the page the changelog is created UNDER, as a page id
# (with or without hyphens). Get it from the page URL's trailing id. The
# connected Notion account must have access to that page.
NOTION_PARENT_PAGE_ID=

# Publish targets. Either can be turned off independently, so a team that uses
# only one tool does not need a dummy destination for the other.
PUBLISH_CONFLUENCE=true
PUBLISH_NOTION=true

# Linear enrichment. When on, the agent parses Linear identifiers (ENG-123)
# out of PR titles, bodies, and branch names and links each entry to its
# issue. Turn it off if your workspace has no Linear connection -- the
# changelog still links every PR, it just omits the Linear references.
ENABLE_LINEAR=true

# Comma-separated Linear team prefixes (e.g. "ENG,PLAT"). Setting these makes
# identifier matching exact, which avoids false positives on strings that look
# like issue keys but are not (UTF-8, CVE-2026, HTTP-404). Leave blank to
# match any 2-5 letter uppercase prefix.
LINEAR_TEAM_PREFIXES=

# Max pull requests hydrated per run (GitHub's per_page cap is 100).
MAX_PRS=100

# Render the changelog and print it without publishing anywhere.
# Also available as: python run_flow.py --dry-run
DRY_RUN=false

# Logging
LOG_LEVEL=INFO
