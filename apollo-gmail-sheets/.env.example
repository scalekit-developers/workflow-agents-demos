# ── Scalekit ──────────────────────────────────────────────────────────────────
# Get from app.scalekit.com → Settings → API Credentials
SCALEKIT_ENV_URL=https://your-env.scalekit.dev
SCALEKIT_CLIENT_ID=skc_xxxxxxxxxxxx
SCALEKIT_CLIENT_SECRET=your_secret_here

# ── Connector user identifiers ────────────────────────────────────────────────
# The email address used to authorize each connector in Scalekit.
# Can be the same address for all three if using one Google account.
APOLLO_USER=you@yourcompany.com
GMAIL_USER=you@yourcompany.com
SHEETS_USER=you@yourcompany.com

# ── Google Sheets ──────────────────────────────────────────────────────────────
# SHEETS_ID: the long alphanumeric string in your Sheet URL
#   https://docs.google.com/spreadsheets/d/SHEETS_ID/edit
SHEETS_ID=your_sheet_id_here
# SHEETS_RANGE: sheet tab name + column range to append rows into
SHEETS_RANGE=Sheet1!A:H

# ── ICP filters ───────────────────────────────────────────────────────────────
# Comma-separated, no spaces. Adjust to match your ideal customer profile.
ICP_TITLES=VP of Sales,Head of Sales,Director of Sales,CRO
ICP_INDUSTRIES=SaaS,Software,Technology
ICP_EMP_MIN=50
ICP_EMP_MAX=5000
PROSPECT_LIMIT=5

# ── Sample data mode ──────────────────────────────────────────────────────────
# Set to true to skip Apollo and use the five bundled sample prospects.
# Gmail drafts and Sheets logging still run against your real accounts.
USE_SAMPLE_DATA=false

# ── LLM via OpenRouter (optional) ─────────────────────────────────────────────
# If set, uses an LLM to write personalized outreach emails.
# If not set, falls back to a template that still references real buying signals.
# Free key at openrouter.ai — the model below is free tier.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-27b-it:free
