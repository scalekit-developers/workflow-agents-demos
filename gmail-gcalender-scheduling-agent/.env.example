# .env.example — Gmail Scheduling Agent
# Copy to .env and fill in real values before running.

# ── Scalekit (agent auth) ─────────────────────────────────────────────────────
SCALEKIT_ENV_URL=https://yourenv.scalekit.dev
SCALEKIT_CLIENT_ID=your_scalekit_client_id
SCALEKIT_CLIENT_SECRET=your_scalekit_client_secret

# ── Identity ──────────────────────────────────────────────────────────────────
# The email address whose Gmail + Google Calendar to watch
SCALEKIT_IDENTIFIER=your@email.com

# ── LLM (Claude for scheduling intent extraction) ─────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Scheduling defaults ───────────────────────────────────────────────────────
USER_DEFAULT_TZ=Asia/Kolkata
WORK_START_LOCAL=10:00
WORK_END_LOCAL=18:00
DEFAULT_DURATION_MIN=30
BUFFER_MIN=10

# ── Polling ───────────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=60

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
