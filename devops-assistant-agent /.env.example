# Scalekit credentials — from your Scalekit environment dashboard
SCALEKIT_ENV_URL=https://your-env.scalekit.dev
SCALEKIT_CLIENT_ID=your_client_id
SCALEKIT_CLIENT_SECRET=your_client_secret

# Scalekit connection identifiers — the user/identifier string used to resolve
# each connected account (GitHub, Linear, Slack) inside Scalekit.
# In production pass per-user IDs; for dev you can use a fixed test identifier.
GITHUB_IDENTIFIER=your_github_identifier
LINEAR_IDENTIFIER=your_linear_identifier
SLACK_IDENTIFIER=your_slack_identifier

# Connection names — the exact connector name from Scalekit dashboard → Connected Accounts.
# Set these when one identifier maps to multiple connections for the same service.
# Find yours in the "connector" column. Example: slack-sKfekCVz, github-g0DJbhbx
GITHUB_CONNECTION_NAME=github-g0DJbhbx
LINEAR_CONNECTION_NAME=linear-wuvcVfMm
SLACK_CONNECTION_NAME=slack-sKfekCVz

# GitHub repository to monitor
GITHUB_REPO_OWNER=your_org_or_username
GITHUB_REPO_NAME=your_repo

# Slack channel to post the daily digest to (starts with C, e.g. C1234567890)
SLACK_DIGEST_CHANNEL_ID=C1234567890

# Linear — default team for new issues created from labeled PRs
LINEAR_TEAM_ID=your_linear_team_id

# Optional: map specific PR labels to different Linear team IDs
# Example: {"bug":"team_id_for_bug","feature":"team_id_for_feature"}
LABEL_TO_LINEAR_TEAM={}

# Optional tuning
DIGEST_STALE_DAYS=5
RETRY_ATTEMPTS=3
RETRY_BACKOFF=1
LOG_LEVEL=INFO
