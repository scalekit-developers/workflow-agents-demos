# Scalekit credentials (from your Scalekit workspace dashboard)
SCALEKIT_ENV_URL=https://your-workspace.scalekit.dev
SCALEKIT_CLIENT_ID=skc_...
SCALEKIT_CLIENT_SECRET=test_...

# Your identity per connector -- used as the "identifier" for each connected account.
# These are usually the PMM's own email, but can differ per connector if you
# authorize with a shared service account for Gong/Notion/Slack.
GONG_USER=pmm@yourcompany.com
NOTION_USER=pmm@yourcompany.com
SLACK_USER=pmm@yourcompany.com

# Connector names -- these are only used for the Step 0 auth-check
# (get_or_create_connected_account) AND to disambiguate execute_tool() calls
# when one identifier is connected to multiple connectors of the same
# provider type. Must match the EXACT connection name shown in your Scalekit
# dashboard under Agent Auth > Connections. Scalekit often auto-suffixes these
# per workspace -- copy the name shown for YOUR connection, never assume the
# generic provider label works.
#
# GONG has zero connected accounts in the reference workspace this agent was
# built against, so this default is a placeholder only. Add a Gong connection
# in your Scalekit dashboard first (see README Prerequisites), then set this
# to the exact name shown there.
GONG_CONNECTOR=GONG

# NotionMCP connector name as configured in Scalekit -- copy the exact name
# shown in your dashboard (e.g. "notionmcp-chAb8Lfz"). Page creation/read
# requires an MCP-variant Notion connection (plain "Notion" does not expose
# the tools this agent uses).
NOTION_CONNECTOR=notionmcp-chAb8Lfz

# SlackMCP connector name as configured in Scalekit -- copy the exact name
# shown in your dashboard (e.g. "slackmcp").
SLACK_CONNECTOR=slackmcp

# The PMM this cycle runs on behalf of. Used as a label in logs, as the
# fallback signal for identifying which call participant is the "internal"
# sales rep (via matching email domain) when Gong's affiliation metadata is
# absent, and to disambiguate the connected-account identity per connector.
PMM_EMAIL=pmm@yourcompany.com

# How far back (in days) to search Gong for calls with competitor mentions.
# 7 is a reasonable weekly cadence; use a smaller number with POLLING_MODE
# for a daily digest.
LOOKBACK_DAYS=7

# Competitors to track, comma-separated (e.g. "Salesforce,HubSpot,Pipedrive").
# Matching against Gong tracker hits and transcript text is case-insensitive
# and whole-word (so "Sales" will not falsely match "Salesforce").
COMPETITOR_NAMES=Salesforce,HubSpot,Pipedrive

# Notion parent page under which one battlecard child page per competitor
# already lives (e.g. a page titled "Competitive Battlecards" with child
# pages titled "Salesforce", "HubSpot", etc.). This agent only ever searches
# for and reads an existing battlecard here -- it never creates or edits one,
# since a PMM owns battlecard authorship.
NOTION_BATTLECARDS_PARENT_PAGE_ID=...

# Optional: restrict Gong calls/transcripts to a specific Gong workspace ID.
# Leave blank to search across every workspace the connected account can see.
GONG_WORKSPACE_ID=

# Timing
POLLING_MODE=false
POLL_INTERVAL_MINUTES=60

# Logging
LOG_LEVEL=INFO
