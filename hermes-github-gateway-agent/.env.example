# Copy this file to .env and fill in your values. DO NOT COMMIT the .env file.

# --- Scalekit environment (Dashboard > API Config) ---
SCALEKIT_ENV_URL=https://your-env.scalekit.com
SCALEKIT_CLIENT_ID=skc_your_client_id
SCALEKIT_CLIENT_SECRET=your_client_secret

# Name of the GitHub connection you created in the Scalekit dashboard
# (Dashboard > Connections > GitHub). Defaults to "github" — change this if
# you named it differently, e.g. "github-g0DJbhbx".
SCALEKIT_GITHUB_CONNECTION=github

# --- MCP gateway ---
# Name for the MCP config this script creates/reuses (idempotent by name).
MCP_CONFIG_NAME=hermes-github-gateway

# Comma-separated tool names exposed to Hermes through the gateway. Keep this
# narrow — Hermes only ever sees these tools, nothing else the connector exposes.
# These three are real tool names on Scalekit's GitHub connector, confirmed via
# client.tools.list_tools(filter=Filter(provider="GITHUB")).
MCP_TOOLS=github_search_issues,github_issue_labels_add,github_issue_get

# --- End-user identity ---
# Identifier for the connected account Hermes acts as. In production this is
# your app's real user ID / email, not a shared constant.
HERMES_USER_IDENTIFIER=local-hermes-user

# Hours the minted MCP session token stays valid before Hermes needs a new one.
SESSION_TOKEN_TTL_HOURS=8

# Where to write the generated Hermes config snippet.
HERMES_CONFIG_SNIPPET_PATH=hermes_mcp_config.snippet.yaml
