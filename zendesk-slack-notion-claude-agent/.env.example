# Scalekit credentials (from your Scalekit workspace dashboard)
SCALEKIT_ENV_URL=https://your-workspace.scalekit.dev
SCALEKIT_CLIENT_ID=skc_...
SCALEKIT_CLIENT_SECRET=test_...

# Your identity -- used as the "identifier" for each connected account
SUPPORT_EMAIL=support@yourcompany.com
ZENDESK_USER=support@yourcompany.com
SLACK_USER=support@yourcompany.com
NOTION_USER=support@yourcompany.com

# Connector names -- must match what you named them in the Scalekit dashboard
SLACK_CONNECTOR=slack

# Notion KB database ID (from the Notion URL of your KB database)
NOTION_DB_ID=

# Slack channel routing (channel names or IDs)
# CHANNEL_BUG=#engineering
# CHANNEL_BILLING=#billing
# CHANNEL_FEATURE=#product-feedback
# CHANNEL_HOWTO=#support-triage
# CHANNEL_ACCOUNT=#support-triage
# FALLBACK_CHANNEL=#support-triage

# Timing
POLL_INTERVAL_MINUTES=2
POLLING_MODE=false

# Logging
LOG_LEVEL=INFO

# LLM via OpenRouter (optional, falls back to rule-based if missing)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini
