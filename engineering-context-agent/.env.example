# ── Scalekit credentials ──────────────────────────────────────────────────────
SCALEKIT_ENV_URL=https://your-env.scalekit.dev
SCALEKIT_CLIENT_ID=skc_xxxxxxxxxxxx
SCALEKIT_CLIENT_SECRET=your_secret_here

# ── Connector names (copy exact names from app.scalekit.com → Agent Auth → Connections)
GITHUB_CONNECTOR=github
GITLAB_CONNECTOR=gitlab
JIRA_CONNECTOR=jira
SLACK_CONNECTOR=slack

# ── Engineer config ────────────────────────────────────────────────────────────
# Single-engineer mode (default). For multi-engineer, set ENGINEERS as a JSON array instead.

ENGINEER_ID=eng_alice_123
ENGINEER_NAME=Alice

# GitHub: your GitHub username and the repos to check for open PRs
# GITHUB_REPOS is a comma-separated list of "owner/repo" pairs
GITHUB_USERNAME=alice
GITHUB_REPOS=acme-corp/api-gateway,acme-corp/auth-service
GITHUB_ORG=acme-corp

# GitLab: URL-encoded project path (e.g. acme-corp%2Fpayment-service)
# and your GitLab numeric user ID (Profile → Edit profile → User ID)
GITLAB_PROJECT_PATH=acme-corp%2Fpayment-service
GITLAB_USER_ID=12345678

# Slack: your Slack member ID (click your profile → three-dot menu → Copy member ID)
SLACK_USER_ID=U0XXXXXXXXX

# ── Multi-engineer mode (optional) ────────────────────────────────────────────
# Set ENGINEERS as a JSON array to run for multiple engineers at once.
# If set, the single-engineer vars above are ignored.
#
# ENGINEERS=[
#   {
#     "id": "eng_alice_123",
#     "name": "Alice",
#     "github_username": "alice",
#     "github_repos": ["acme-corp/api-gateway", "acme-corp/auth-service"],
#     "github_org": "acme-corp",
#     "gitlab_project_path": "acme-corp%2Fpayment-service",
#     "gitlab_user_id": "12345678",
#     "slack_user_id": "U0XXXXXXXXX"
#   },
#   {
#     "id": "eng_bob_456",
#     "name": "Bob",
#     "github_username": "bob",
#     "github_repos": ["acme-corp/frontend"],
#     "github_org": "acme-corp",
#     "gitlab_project_path": "acme-corp%2Ffrontend",
#     "gitlab_user_id": "87654321",
#     "slack_user_id": "U1YYYYYYYYY"
#   }
# ]

# ── LLM (optional) ────────────────────────────────────────────────────────────
# If set, the agent uses an LLM to write each engineer's digest.
# If not set, a rule-based formatter is used automatically.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3-haiku
