# Scalekit credentials (from your Scalekit workspace dashboard)
SCALEKIT_ENV_URL=https://your-workspace.scalekit.dev
SCALEKIT_CLIENT_ID=skc_...
SCALEKIT_CLIENT_SECRET=test_...

# Your identity per connector -- used as the "identifier" for each connected
# account. Usually the HR admin's own email, but can differ per connector if
# you authorize with a shared service account for Deel/Notion/Slack.
DEEL_USER=hradmin@yourcompany.com
NOTION_USER=hradmin@yourcompany.com
SLACK_USER=hradmin@yourcompany.com

# Google Workspace identity, only needed once GOOGLEDWD is actually connected
# (see Prerequisites in README). Leave unset to have this step skip cleanly
# with a clear log message every run. MUST be a Workspace SUPER ADMIN --
# confirmed live: a non-admin subject gets a real 403 "Not Authorized to
# access this resource/api" from Google's Admin Directory API even when the
# DWD connection itself is ACTIVE and correctly scoped. There is no fallback
# to HR_ADMIN_EMAIL for this one connector precisely because that admin is
# not guaranteed to be a Workspace Super Admin.
GOOGLE_WORKSPACE_USER=

# Connector names -- these are only used for the Step 0 auth-check
# (get_or_create_connected_account) AND to disambiguate execute_tool() calls
# when one identifier is connected to multiple connectors of the same
# provider type. Must match the EXACT connection name shown in your Scalekit
# dashboard under Agent Auth > Connections. Scalekit often auto-suffixes
# these per workspace (e.g. "deelmcp-zTWsHKTh") -- copy the name shown for
# YOUR connection, the defaults below are unlikely to match another
# workspace exactly.
DEEL_CONNECTOR=deelmcp-zTWsHKTh
NOTION_CONNECTOR=notionmcp-chAb8Lfz
SLACK_CONNECTOR=slackmcp
GOOGLE_WORKSPACE_CONNECTOR=googledwd-f0ebCm3b

# The HR admin this run is on behalf of. Used only as a label in logs/state.
HR_ADMIN_EMAIL=hradmin@yourcompany.com

# Which mode this run operates in:
#   create -- one new hire's real details come directly from NEW_HIRE_*
#     below, and this agent creates a REAL employee record in Deel from
#     them (deelmcp_org_direct_employee_create). There is no delete/
#     terminate tool for a direct employee anywhere in Deel's catalog
#     (verified live), so double-check NEW_HIRE_* before running with
#     NEW_HIRE_DRY_RUN=false.
#   scan -- hires are detected FROM Deel's onboarding tracker instead
#     (deelmcp_onboarding_tracker_list, filtered to progress status
#     INVITED -- verified live, see connectors.py and hire.py). This agent
#     never creates a Deel record in this mode; an HR admin already created
#     the hire directly in Deel. NEW_HIRE_* below is ignored in this mode.
NEW_HIRE_MODE=create

# The new hire's real details (create mode only, ignored in scan mode).
NEW_HIRE_FIRST_NAME=Jane
NEW_HIRE_LAST_NAME=Doe
NEW_HIRE_PERSONAL_EMAIL=jane.doe.personal@example.com
NEW_HIRE_WORK_EMAIL=jane.doe@yourcompany.com
NEW_HIRE_COUNTRY=US
# State/province is required by Deel for some countries (confirmed live for
# India) -- if creation fails with "No state was selected", set this.
NEW_HIRE_STATE=
NEW_HIRE_NATIONALITY=US
NEW_HIRE_JOB_TITLE=Software Engineer
# Must match (a substring of, case-insensitive) a real seniority level name
# from deelmcp_lookup_seniority_list, e.g. "Junior", "Mid", "Senior", "Lead",
# "Director". If this doesn't match, the agent fails with the real list of
# valid options from your Deel account.
NEW_HIRE_SENIORITY=Mid
NEW_HIRE_START_DATE=2026-09-01
NEW_HIRE_SALARY=80000
NEW_HIRE_CURRENCY=USD
NEW_HIRE_EMPLOYMENT_TYPE=FULL_TIME

# Optional: skip auto-resolution at startup by setting these directly. Left
# blank, the agent resolves them automatically IF exactly one legal
# entity/team exists in your Deel account (verified live: both are genuine
# no-argument bulk-listing tools) -- otherwise it fails with the real list
# of options and asks you to pick.
DEEL_LEGAL_ENTITY_ID=
DEEL_TEAM_ID=
DEEL_DEPARTMENT_ID=

# STRONGLY RECOMMENDED for first-time setup: resolves every real ID (legal
# entity, team, seniority) and logs exactly what WOULD be created, without
# ever calling the real Deel creation tool. Deel has no way to undo a real
# creation through any Scalekit tool, so verify with this first.
NEW_HIRE_DRY_RUN=true

# Notion destination -- an existing page under which onboarding docs get
# created as child pages. NOTION_TEMPLATE_PAGE_ID is accepted as an alias.
NOTION_PARENT_PAGE_ID=

# Slack destination -- a channel name (e.g. "#general") or a literal channel
# ID. This is a shared team channel, not a DM.
SLACK_WELCOME_CHANNEL=#general

# Domain used to construct the new hire's Google Workspace email address
# (see README Prerequisites for the DWD setup this requires). Leave blank to
# skip Google Workspace provisioning cleanly.
GOOGLE_WORKSPACE_DOMAIN=

# Timing / mode. Provisioning one hire is inherently a one-shot action once
# completed; POLLING_MODE here re-checks whether the CONFIGURED hire has
# finished processing yet, rather than re-creating a completed hire on a
# timer (see state.py and run_flow.py).
POLLING_MODE=false
POLL_INTERVAL_MINUTES=15

# Logging
LOG_LEVEL=INFO
