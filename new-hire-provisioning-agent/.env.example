# Scalekit credentials (from your Scalekit workspace dashboard)
SCALEKIT_ENV_URL=https://your-workspace.scalekit.dev
SCALEKIT_CLIENT_ID=skc_...
SCALEKIT_CLIENT_SECRET=test_...

# Your identity per connector -- used as the "identifier" for each connected
# account. Usually the HR admin's own email, but can differ per connector if
# you authorize with a shared service account for Gusto/Notion/Slack.
GUSTO_USER=hradmin@yourcompany.com
NOTION_USER=hradmin@yourcompany.com
SLACK_USER=hradmin@yourcompany.com

# Google Workspace identity, only needed once GOOGLEDWD is actually connected
# (see Prerequisites in README). Leave unset to have this step skip cleanly
# with a clear log message every run.
GOOGLE_WORKSPACE_USER=

# Connector names -- these are only used for the Step 0 auth-check
# (get_or_create_connected_account) AND to disambiguate execute_tool() calls
# when one identifier is connected to multiple connectors of the same
# provider type. Must match the EXACT connection name shown in your Scalekit
# dashboard under Agent Auth > Connections. Scalekit often auto-suffixes these
# per workspace (e.g. "gustomcp-SoSOMZ20", "notionmcp-chAb8Lfz") -- copy the
# name shown for YOUR connection, the defaults below are unlikely to match
# another workspace exactly.
GUSTO_CONNECTOR=gustomcp-SoSOMZ20
NOTION_CONNECTOR=notionmcp-chAb8Lfz
SLACK_CONNECTOR=slackmcp

# Google Workspace (Domain-Wide Delegation) connector name. The Scalekit
# catalog identifier for this connector is "GOOGLEDWD" ("Google Workspace
# (DWD)"), but it must be connected (not just present in the catalog) before
# this step will work -- see README Prerequisites for the full GCP service
# account + Domain-Wide Delegation setup this requires. Until then this step
# logs a clear "not configured" warning per new hire and does not block
# Notion/Slack.
GOOGLE_WORKSPACE_CONNECTOR=googledwd

# The HR admin this agent runs on behalf of (used in logs/state; Gusto
# queries themselves are org-wide, all employees in the connected company).
HR_ADMIN_EMAIL=hradmin@yourcompany.com

# One-shot overrides to target a SPECIFIC new hire instead of scanning Gusto
# for everyone not yet provisioned. Leave both blank for the default
# scan-based behavior (recommended for normal/scheduled runs).
NEW_HIRE_EMPLOYEE_ID=
NEW_HIRE_NAME=

# An existing Notion page to create onboarding docs under, as child pages.
# Share this page with your Notion integration first (Connections menu on
# the page in Notion), then copy its page ID from the page URL.
# NOTION_TEMPLATE_PAGE_ID is accepted as an alias for the same setting.
NOTION_PARENT_PAGE_ID=
NOTION_TEMPLATE_PAGE_ID=

# Shared Slack channel every new hire's welcome message posts to (not a DM).
# A channel name (resolved via slackmcp_slack_search_channels) or a literal
# channel ID (C..., G...). Make sure the connected Slack bot is a member.
SLACK_WELCOME_CHANNEL=#general

# Domain used to construct the new hire's Google Workspace email address,
# e.g. "yourcompany.com" -> "jane.doe@yourcompany.com". Only used by the
# Google Workspace provisioning step; leave blank to skip that step cleanly.
GOOGLE_WORKSPACE_DOMAIN=

# How far back/ahead of today (in days) a Gusto employee's start_date can be
# for that record to be considered a "new hire" during a scan. A record is
# also considered a new hire if Gusto's onboarded flag is false, regardless
# of this window.
NEW_HIRE_LOOKBACK_DAYS=14
NEW_HIRE_LOOKAHEAD_DAYS=30

# Timing
POLLING_MODE=false
POLL_INTERVAL_MINUTES=60

# Logging
LOG_LEVEL=INFO
