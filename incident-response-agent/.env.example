# Scalekit
SCALEKIT_ENV_URL=https://your-env.scalekit.dev
SCALEKIT_CLIENT_ID=skc_xxxxxxxxxxxxxxxxxxx
SCALEKIT_CLIENT_SECRET=your_client_secret_here

# Identity each connector is authorized under. Usually the on-call engineer's
# own email (the brief: "delegate OAuth to your engineers"), but can differ
# per connector if a shared on-call bot account authorizes some of them.
PAGERDUTY_USER=you@example.com
JIRA_USER=you@example.com
CONFLUENCE_USER=you@example.com
SLACK_USER=you@example.com

# Exact connection names from the Scalekit dashboard (Agent Auth > Connections).
# Scalekit auto-suffixes these per workspace -- verify yours, do not assume
# the plain provider label works.
PAGERDUTY_CONNECTOR=PAGERDUTY
JIRA_CONNECTOR=JIRA
CONFLUENCE_CONNECTOR=CONFLUENCE
SLACK_CONNECTOR=SLACKMCP

# The on-call engineer this run is on behalf of. Required by PagerDuty's API
# on every write (From-email header) and included in the Jira/Confluence context.
ONCALL_EMAIL=you@example.com

# PagerDuty service to page. Provide EITHER the ID directly (fastest, no
# lookup) OR a name to resolve at startup via pagerduty_services_list -- if
# both are set, PAGERDUTY_SERVICE_ID wins.
PAGERDUTY_SERVICE_ID=
PAGERDUTY_SERVICE_NAME=Production API

# Jira project and issue type the incident ticket is created under. Issue
# type names are project-specific -- verify yours before relying on the
# default (run jira_issue_create_meta_issue_types_list for your project).
JIRA_PROJECT_KEY=OPS
JIRA_ISSUE_TYPE=Bug

# Optional: your real Jira site URL (e.g. https://yourteam.atlassian.net),
# used to build a clickable ticket link in Slack/PagerDuty/Confluence.
# Leave blank to reference tickets by key alone (e.g. "ECS-17") -- no tool
# in this connector's catalog can discover the real site name, so this is
# never guessed; get it from your own browser's address bar.
JIRA_SITE_URL=

# Confluence space (numeric ID, not the space key) the postmortem doc is
# created under, and an optional parent page ID to nest it under.
CONFLUENCE_SPACE_ID=
CONFLUENCE_PARENT_PAGE_ID=

# Slack channel notified with the incident summary and Jira link. A channel
# ID (C0123456789) is used as-is; a bare name is resolved at startup.
SLACK_CHANNEL=on-call

LOG_LEVEL=INFO
