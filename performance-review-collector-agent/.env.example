# Scalekit credentials (from your Scalekit workspace dashboard)
SCALEKIT_ENV_URL=https://your-workspace.scalekit.dev
SCALEKIT_CLIENT_ID=skc_...
SCALEKIT_CLIENT_SECRET=test_...

# Your identity per connector -- used as the "identifier" for each connected account.
# These are usually the manager's own email, but can differ per connector if you
# authorize with a shared service account for Airtable/Forms/Notion.
AIRTABLE_USER=manager@yourcompany.com
GOOGLE_FORMS_USER=manager@yourcompany.com
NOTION_USER=manager@yourcompany.com
SLACK_USER=manager@yourcompany.com

# Connector names -- these are only used for the Step 0 auth-check
# (get_or_create_connected_account) and must match the EXACT connection name
# shown in your Scalekit dashboard under Agent Auth > Connections. Scalekit
# often auto-suffixes these per workspace (e.g. "airtable-3j16TKTG",
# "googleforms-WqF2XTWv") -- copy the name shown for YOUR connection, the
# defaults below are unlikely to match another workspace exactly.
AIRTABLE_CONNECTOR=airtable
GOOGLE_FORMS_CONNECTOR=googleforms

# Notion connector name as configured in Scalekit -- copy the exact name shown
# in your dashboard (e.g. "notionmcp-chAb8Lfz"). Page creation requires an
# MCP-variant Notion connection (plain "Notion" does not expose page-create tools).
NOTION_CONNECTOR=notionmcp

# Slack connector name as configured in Scalekit -- copy the exact name shown
# in your dashboard (e.g. "slackmcp"). Any name containing "mcp" uses
# slackmcp_slack_send_message (channel_id/message); anything else falls back
# to the plain slack_send_message (channel/text).
SLACK_CONNECTOR=slackmcp

# The manager running this cycle. Feedback is scoped to their direct reports only.
MANAGER_EMAIL=manager@yourcompany.com
# Slack user/member ID to DM the digest to. Defaults to MANAGER_EMAIL if your
# Slack connector resolves DMs by email; set explicitly if it needs a member ID (U0123...).
MANAGER_SLACK_ID=

# Optional fallback: comma-separated direct report names, used only if no Airtable
# record is tagged with this manager's email in AIRTABLE_MANAGER_FIELD.
DIRECT_REPORTS=

# Airtable source (structured ratings)
AIRTABLE_BASE_ID=app...
AIRTABLE_TABLE_NAME=Performance Reviews
AIRTABLE_MANAGER_FIELD=Manager Email
AIRTABLE_EMPLOYEE_FIELD=Employee Name
# Optional: restrict to a specific Airtable view (name or ID)
AIRTABLE_VIEW=

# Google Forms source (free-text feedback)
GOOGLE_FORM_ID=...
# The form's question ID that asks "Which employee is this feedback about?"
# Get this from googleforms_get_form. If left blank, the agent best-effort
# guesses the employee from the shortest text answer in each response.
FORM_EMPLOYEE_QUESTION_ID=

# Notion destination -- the parent page under which per-employee pages are created
NOTION_PARENT_PAGE_ID=...

# Label used in summaries and page titles, e.g. "Q2 2026"
REVIEW_PERIOD=Current Cycle

# Timing
POLLING_MODE=false
POLL_INTERVAL_MINUTES=60

# Logging
LOG_LEVEL=INFO

# LLM via OpenRouter (optional, falls back to a deterministic rule-based
# summary if missing or if the call fails)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini
