# Scalekit credentials (from your Scalekit workspace dashboard)
SCALEKIT_ENV_URL=https://your-workspace.scalekit.dev
SCALEKIT_CLIENT_ID=skc_...
SCALEKIT_CLIENT_SECRET=test_...

# Your identity per connector -- used as the "identifier" for each connected
# account. These are usually the People Ops operator's own email (the person
# whose Scalekit-connected Gusto/Slack/Sheets access the agent uses to make
# API calls), NOT the employee whose payroll record is being changed. See
# EMPLOYEE_EMAIL below for that.
GUSTO_USER=peopleops@yourcompany.com
SLACK_USER=peopleops@yourcompany.com
GOOGLE_SHEETS_USER=peopleops@yourcompany.com

# Connector names -- these are only used for the Step 0 auth-check
# (get_or_create_connected_account) AND to disambiguate execute_tool() calls
# when one identifier is connected to multiple connectors of the same
# provider type. Must match the EXACT connection name shown in your Scalekit
# dashboard under Agent Auth > Connections. Scalekit often auto-suffixes these
# per workspace (e.g. "gustomcp-SoSOMZ20", "googlesheets-BOzvgKS0") -- copy
# the name shown for YOUR connection, the defaults below are unlikely to
# match another workspace exactly.
GUSTO_CONNECTOR=gustomcp-SoSOMZ20

# SlackMCP connector name as configured in Scalekit -- copy the exact name
# shown in your dashboard (e.g. "slackmcp"). The plain "SLACK" connector
# variant commonly sits in PENDING_AUTH and is not used by this agent.
SLACK_CONNECTOR=slackmcp

# Google Sheets connector name as configured in Scalekit (e.g. "googlesheets-BOzvgKS0").
GOOGLE_SHEETS_CONNECTOR=googlesheets-BOzvgKS0

# --- Whose payroll record this run is about (the delegated identity) ---

# The employee whose Gusto record will be looked up, whose eligibility will
# be checked, and whose payroll/bank details are being changed. The Slack
# confirmation also goes to this person, NOT a manager.
EMPLOYEE_EMAIL=employee@yourcompany.com

# Optional: if you already know the employee's Gusto UUID, set it here to
# skip the email-based lookup (list_employees/list_contractors + client-side
# match). Leave blank to resolve by EMPLOYEE_EMAIL automatically.
EMPLOYEE_GUSTO_ID=

# Optional hint: "employee" (W-2) or "contractor". Leave blank to let the
# agent try employee first, then fall back to contractor -- Gusto companies
# can be employee-only, contractor-only, or mixed.
EMPLOYEE_RECORD_TYPE=

# Optional: if you already know the employee's Slack user ID (e.g. U0123ABCD),
# set it here to skip the slackmcp_slack_search_users lookup by email.
EMPLOYEE_SLACK_ID=

# --- The change being requested ---

# One of: bank_account | routing_number | pay_rate | compensation
# Structured and extensible on purpose -- "payroll or bank detail change" can
# mean more than just direct deposit. Add new types by extending
# SUPPORTED_CHANGE_TYPES in config.py and a matching rule in
# aggregator.py's validate_new_value().
CHANGE_TYPE=routing_number

# The new value being set for CHANGE_TYPE. NEVER commit a real value here.
# This is a fake, obviously-non-real placeholder -- it is NOT a valid ABA
# routing number and will fail this agent's own checksum validation on
# purpose, so nobody mistakes this file for something safe to run as-is.
# For a bank_account change, use a similarly obviously-fake numeric string,
# e.g. "000000000". This value is NEVER logged, NEVER written to Google
# Sheets, and NEVER included in the Slack confirmation in full -- only a
# masked "ending in XXXX" form is ever recorded. See README's "Data Handling
# & Security" section.
NEW_VALUE=000000000

# --- Google Sheets audit log destination ---

# The spreadsheet must already exist (create one manually at sheets.google.com).
# The tab/sheet name below is auto-created inside it if missing.
GOOGLE_SHEETS_SPREADSHEET_ID=...
GOOGLE_SHEETS_TAB_NAME=Payroll Change Log

# --- Safety: simulated-submission mode ---

# When true, Step 2 does NOT call any real Gusto write tool -- it logs a
# clearly-marked "SIMULATED" result and lets the rest of the pipeline
# (idempotency, masking, Sheets logging, Slack confirmation) run end to end
# so you can validate the full flow without any live Gusto write. This is
# also the mode this agent runs in today by necessity: verified live, this
# workspace's GustoMCP connector exposes no write tool at all (see
# connectors.py). Leave this false to see the real "no write tool available"
# error path, or true to exercise the rest of the pipeline safely.
SIMULATE_SUBMISSION=false

# Logging
LOG_LEVEL=INFO
