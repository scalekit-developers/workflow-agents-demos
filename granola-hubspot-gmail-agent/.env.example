# ── Scalekit ─────────────────────────────────────────────────────────────────
# Get from app.scalekit.com → Settings → API Credentials
SCALEKIT_ENV_URL=https://your-env.scalekit.dev
SCALEKIT_CLIENT_ID=skc_xxxxxxxxxxxx
SCALEKIT_CLIENT_SECRET=your_secret_here

# ── Connector user identifiers ───────────────────────────────────────────────
# The email/ID you use to identify this user across all connectors
GRANOLA_USER=you@yourcompany.com
HUBSPOT_USER=you@yourcompany.com
GMAIL_USER=you@yourcompany.com
SLACK_USER=you@yourcompany.com

# ── Slack ─────────────────────────────────────────────────────────────────────
# SLACK_CONNECTOR: the connection name you set in Scalekit dashboard
#   (Scalekit Dashboard → Agent Auth → Connections → your Slack connection name)
SLACK_CONNECTOR=slack
# SLACK_CHANNEL: channel ID to post summaries to
#   (copy from Slack channel URL, or run slack_list_channels via the agent)
SLACK_CHANNEL=C0XXXXXXXXX

# ── LLM via OpenRouter (optional) ────────────────────────────────────────────
# If set, uses LLM for smarter meeting extraction.
# If not set, falls back to a rule-based parser — no API needed.
# Free key at openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
