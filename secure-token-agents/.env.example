# Example .env file for ScaleKit HubSpot Flow

# ScaleKit Configuration
SCALEKIT_URL=https://hey.scalekit.dev
SCALEKIT_CLIENT_ID=your-client-id
SCALEKIT_CLIENT_SECRET=your-client-secret
SCALEKIT_IDENTIFIER=your-identifier

# HubSpot Configuration
HUBSPOT_CLIENT_ID=your-hubspot-client-id
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret
HUBSPOT_REFRESH_TOKEN=your-hubspot-refresh-token
HUBSPOT_ACCESS_TOKEN=your-hubspot-access-token

# Optional Configuration
SAVE_TOKENS_TO_ENV=1
SIMULATE_EXPIRE_DELAY=60