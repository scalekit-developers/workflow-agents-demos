# ── Scalekit ──────────────────────────────────────────────────────────────────
# Get from app.scalekit.com → Settings → API Credentials
SCALEKIT_ENV_URL=https://your-env.scalekit.dev
SCALEKIT_CLIENT_ID=skc_xxxxxxxxxxxx
SCALEKIT_CLIENT_SECRET=your_secret_here

# ── Connector user identifiers ────────────────────────────────────────────────
# The email used to identify this user across all connectors
GONG_USER=you@yourcompany.com
ATTIO_USER=you@yourcompany.com
SLACK_USER=you@yourcompany.com

# ── Connector names ───────────────────────────────────────────────────────────
# Must match the connection names in your Scalekit dashboard EXACTLY,
# including any auto-generated suffix (e.g., slack-sKfekCVz).
# Dashboard → Agent Auth → Connections → copy the connection name.
GONG_CONNECTOR=gong
ATTIO_CONNECTOR=attio
SLACK_CONNECTOR=slack

# ── Slack ──────────────────────────────────────────────────────────────────────
# Slack user ID of the sales leader to DM the risk report to.
# Open Slack → click their profile → three-dot menu → Copy Member ID (looks like U0XXXXXXXXX).
SLACK_DM_USER=U0XXXXXXXXX

# ── Gong direct API (for create_gong_calls.py only — agent uses Scalekit) ──────
# Gong → Settings → Company Settings → API → Create Access Key
# Only needed if you want to create real Gong calls via create_gong_calls.py.
# The main agent (run_flow.py) uses Scalekit and does NOT need these.
GONG_ACCESS_KEY=your_gong_access_key
GONG_ACCESS_SECRET=your_gong_access_secret

# ── Attio API key (for seed_data.py only — agent uses Scalekit to read Attio) ─
# Attio → Settings → API Keys → Create API Key
# Only needed if you want to seed demo data via seed_data.py.
ATTIO_API_KEY=your_attio_api_key_here

# ── LLM via OpenRouter (optional) ────────────────────────────────────────────
# If set, uses an LLM to analyze call sentiment, objections, and competitors.
# If not set, falls back to a rule-based analyzer — no API key needed.
# Free key at openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
