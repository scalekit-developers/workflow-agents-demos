# Scalekit credentials (from your Scalekit workspace dashboard)
SCALEKIT_ENV_URL=https://your-workspace.scalekit.dev
SCALEKIT_CLIENT_ID=skc_...
SCALEKIT_CLIENT_SECRET=test_...

# Your identity per connector -- used as the "identifier" for each connected account.
# These are usually the AE's own email, but can differ per connector if you
# authorize with a shared service account for one of them.
SALESFORCE_USER=ae@yourcompany.com
SLACK_USER=ae@yourcompany.com
GOOGLE_DRIVE_USER=ae@yourcompany.com

# Connector names -- these are only used for the Step 0 auth-check
# (get_or_create_connected_account) and must match the EXACT connection name
# shown in your Scalekit dashboard under Agent Auth > Connections. Scalekit
# often auto-suffixes these per workspace (e.g. "salesforce-1",
# "googledrive-9WdQ8yGN") -- copy the name shown for YOUR connection, the
# defaults below are unlikely to match another workspace exactly.
SALESFORCE_CONNECTOR=salesforce-1

# Slack connector name as configured in Scalekit -- copy the exact name shown
# in your dashboard (e.g. "slackmcp"). This agent is built against the
# SlackMCP tool shapes (slackmcp_slack_search_public_and_private,
# slackmcp_slack_read_channel, slackmcp_slack_send_message); the plain "Slack"
# connector's tools use a different parameter shape and are not supported here.
SLACK_CONNECTOR=slackmcp

# Google Drive connector name as configured in Scalekit -- copy the exact name
# shown in your dashboard (e.g. "googledrive-9WdQ8yGN").
GOOGLE_DRIVE_CONNECTOR=googledrive

# The AE this run is on behalf of. Used for logging/attribution and stamped
# into the synced summary; does not need to match any connector identifier above.
AE_EMAIL=ae@yourcompany.com

# Which opportunity to sync. Set OPPORTUNITY_ID for an exact match (recommended
# for production/cron use), or OPPORTUNITY_NAME for a substring match if you
# don't have the Id handy (picks the most recently modified match).
OPPORTUNITY_ID=
OPPORTUNITY_NAME=

# Google Drive destination for the deal room doc.
# Set DEAL_ROOM_DOC_ID to sync to an existing Drive file (recommended once the
# deal room doc already exists). Otherwise set DEAL_ROOM_DOC_NAME and the agent
# finds-or-creates a Google Doc with that name (metadata only; see README's
# "Known Limitations" section for why the doc's body stays empty and how the
# agent syncs via comments instead).
DEAL_ROOM_DOC_ID=
DEAL_ROOM_DOC_NAME=
# Optional: parent folder to create the doc inside, if DEAL_ROOM_DOC_NAME is used
DEAL_ROOM_FOLDER_ID=

# Slack discovery. If SLACK_CHANNEL_ID is set, the agent reads recent messages
# from that channel directly. Otherwise it searches all channels (public +
# private the connected account can see) for SLACK_SEARCH_KEYWORD, falling
# back to the opportunity name if that's unset.
SLACK_CHANNEL_ID=
SLACK_SEARCH_KEYWORD=
SLACK_MESSAGE_LIMIT=20

# Timing
POLLING_MODE=false
POLL_INTERVAL_MINUTES=60

# Logging
LOG_LEVEL=INFO
