
# Example .env for Freshdesk → Google ADK Agent
# Copy this file to .env and fill in your real credentials.


# === Freshdesk API ===

# Your Freshdesk domain (e.g., yourcompany.freshdesk.com)
FRESHDESK_DOMAIN=yourcompany.freshdesk.com
# Your Freshdesk API key (see Profile Settings > API Key)
FRESHDESK_API_KEY=your_freshdesk_api_key

# === Google ADK API ===

# Your Google ADK API key
GOOGLE_ADK_API_KEY=your_google_adk_api_key

# === Polling interval (seconds, optional) ===

# How often to poll Freshdesk for new tickets (default: 60)
POLL_INTERVAL=60
