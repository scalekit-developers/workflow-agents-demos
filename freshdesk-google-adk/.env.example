# .env.example — Freshdesk CSAT Follow-up Agent
# Copy to .env and fill in real values before running.

# ── Scalekit (agent auth) ─────────────────────────────────────────────────────
# Your Scalekit environment URL (e.g. https://yourenv.scalekit.dev)
SCALEKIT_ENV_URL=https://yourenv.scalekit.dev
# Client ID and secret from Scalekit dashboard
SCALEKIT_CLIENT_ID=your_scalekit_client_id
SCALEKIT_CLIENT_SECRET=your_scalekit_client_secret

# ── Freshdesk connected account ───────────────────────────────────────────────
# The user identifier tied to your Freshdesk connected account in Scalekit
FRESHDESK_IDENTIFIER=your@email.com
# Connection name in Scalekit (default: freshdesk)
FRESHDESK_CONNECTION=freshdesk

# ── Google ADK / Gemini ───────────────────────────────────────────────────────
# Google AI Studio API key (aistudio.google.com)
GOOGLE_ADK_API_KEY=your_google_api_key
# Gemini model to use (optional, default: gemini-2.5-flash)
GOOGLE_ADK_MODEL=gemini-2.5-flash

# ── Polling ───────────────────────────────────────────────────────────────────
# How often to check Freshdesk for new resolved tickets, in seconds (default: 60)
POLL_INTERVAL=60

# ── Logging ───────────────────────────────────────────────────────────────────
# Log verbosity: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO
