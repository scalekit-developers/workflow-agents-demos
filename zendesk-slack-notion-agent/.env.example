# Example .env for Zendesk + Slack + Notion Agent

# Zendesk
ZENDESK_API_TOKEN=your-zendesk-api-token
ZENDESK_EMAIL=your-zendesk-email
ZENDESK_SUBDOMAIN=your-zendesk-subdomain

# Slack
SLACK_BOT_TOKEN=your-slack-bot-token
SLACK_CHANNEL_ID=your-slack-channel-id

# Notion
NOTION_API_KEY=your-notion-api-key
NOTION_KB_DATABASE_ID=your-notion-db-id


# Google API Key (required for Gemini via ADK)
# Prefer GOOGLE_API_KEY. If you only have GOOGLE_ADK_API_KEY, it will be used.
GOOGLE_API_KEY=your-google-api-key
# GOOGLE_ADK_API_KEY=your-legacy-adk-api-key

# Optional: choose the Gemini model used by ADK
# Defaults to gemini-2.0-flash if unset
GOOGLE_ADK_MODEL=gemini-2.0-flash

# Logging
LOG_LEVEL=INFO
