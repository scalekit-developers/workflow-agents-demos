# Scalekit credentials
# Get these from your Scalekit dashboard -> Settings -> API Credentials
SCALEKIT_ENV_URL=https://your-env.scalekit.dev
SCALEKIT_CLIENT_ID=your-client-id
SCALEKIT_CLIENT_SECRET=your-client-secret

# Connected account identifiers
# The identifier you used when connecting each account in Scalekit
ZENDESK_IDENTIFIER=support@yourcompany.com
SLACK_IDENTIFIER=support@yourcompany.com
NOTION_IDENTIFIER=support@yourcompany.com

# Connection name pinning (recommended)
# Find these in Scalekit dashboard -> Connected Accounts -> connector column
# Without these, Scalekit resolves by identifier alone — which fails if the
# same identifier has multiple connections for the same service.
ZENDESK_CONNECTION_NAME=zendesk-xxxxxxxx
SLACK_CONNECTION_NAME=slack-xxxxxxxx
NOTION_CONNECTION_NAME=notion-xxxxxxxx

# Application settings
SLACK_SUPPORT_CHANNEL=C1234567890
NOTION_KB_DATABASE_ID=your-notion-database-id

# Google API key for Gemini (used by Google ADK)
GOOGLE_API_KEY=your-google-api-key

# Optional tuning
GOOGLE_ADK_MODEL=gemini-2.0-flash
POLL_INTERVAL=60
LOG_LEVEL=INFO
