# Scalekit credentials — from your Scalekit workspace dashboard
SCALEKIT_CLIENT_ID=your_client_id
SCALEKIT_CLIENT_SECRET=your_client_secret
SCALEKIT_ENV_URL=https://your-workspace.scalekit.dev

# AE identity — used to filter external attendees and as Scalekit connector identifier
AE_EMAIL=you@yourcompany.com

# Scalekit identifier for each connector (typically the AE's email)
CALENDAR_USER=you@yourcompany.com
GRANOLA_USER=you@yourcompany.com
ATTIO_USER=you@yourcompany.com
SLACK_USER=you@yourcompany.com

# Connector names — must match exactly what you named them in the Scalekit dashboard
SLACK_CONNECTOR=slack
GRANOLA_CONNECTOR=granolamcp

# Slack user ID to DM briefs to (Slack profile → Copy member ID, starts with U)
SLACK_DM_USER=U0XXXXXXXXX

# Timing (defaults shown — adjust to taste)
LOOKAHEAD_MINUTES=10080
BRIEF_BEFORE_MINUTES=15
POLL_INTERVAL_MINUTES=15
POLLING_MODE=false

# LLM — Claude via Anthropic (brief generation)
ANTHROPIC_API_KEY=sk-ant-api03-...
CLAUDE_MODEL=claude-haiku-4-5-20251001
