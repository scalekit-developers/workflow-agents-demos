# ── Scalekit ─────────────────────────────────────────────────────────────────
# Get from app.scalekit.com → Settings → API Credentials
SCALEKIT_ENV_URL=https://your-env.scalekit.dev
SCALEKIT_CLIENT_ID=skc_xxxxxxxxxxxx
SCALEKIT_CLIENT_SECRET=your_secret_here

# ── Recruiter identity ───────────────────────────────────────────────────────
# The email/ID that identifies the recruiter across connectors.
# All PandaDoc, Slack, and Gmail calls are scoped to this identity —
# never a shared HR bot account.
RECRUITER_USER=recruiter@yourcompany.com

# Per-connector overrides — only set these if the recruiter authorized a
# connector under a DIFFERENT identifier than RECRUITER_USER (e.g. different
# email aliases per service). Each falls back to RECRUITER_USER if unset.
PANDADOC_USER=
SLACK_USER=
GMAIL_USER=

# ── PandaDoc ──────────────────────────────────────────────────────────────────
# PANDADOC_CONNECTOR: connection name set in Scalekit dashboard (default: pandadocmcp)
PANDADOC_CONNECTOR=pandadocmcp
# PANDADOC_TEMPLATE_UUID: your company's reviewed offer letter TEMPLATE in
#   PandaDoc (Templates tab, NOT a regular document — the two are different
#   resource types in PandaDoc's API and a document ID will be rejected).
#   Get this from PandaDoc → Templates → (your template) → copy UUID from the URL.
#   Required — PandaDoc's live MCP server does not currently implement
#   Markdown-based document creation, so there is no template-free fallback.
PANDADOC_TEMPLATE_UUID=
# Must match a recipient role name that exists on the template.
# PandaDoc's own default role name is "Client", not "Signer".
PANDADOC_RECIPIENT_ROLE=Client

# ── Slack ─────────────────────────────────────────────────────────────────────
# SLACK_CONNECTOR: connection name set in Scalekit dashboard (default: slack)
SLACK_CONNECTOR=slack
# Where approval requests are routed. Set at least one:
#   SLACK_HIRING_MANAGER_ID — a specific hiring manager's Slack user ID (DM)
#   SLACK_APPROVALS_CHANNEL — a shared #offers-approval channel ID
SLACK_HIRING_MANAGER_ID=
SLACK_APPROVALS_CHANNEL=

# ── Approval gate ─────────────────────────────────────────────────────────────
# Requires a SEPARATE "SlackMCP" connection in Scalekit dashboard (Connections
# → Add Connection → search "Slack MCP") — the plain SLACK connector above can
# only send messages, it cannot read reactions back. Without SlackMCP set up,
# set REQUIRE_APPROVAL=false to fall back to notify-only (old) behavior.
SLACKMCP_CONNECTOR=slackmcp
SLACKMCP_USER=
REQUIRE_APPROVAL=true
APPROVE_EMOJI=white_check_mark
REJECT_EMOJI=x
APPROVAL_POLL_INTERVAL_SECONDS=30
APPROVAL_TIMEOUT_SECONDS=1800

# ── Gmail ─────────────────────────────────────────────────────────────────────
GMAIL_CONNECTOR=gmail

# ── Company info ──────────────────────────────────────────────────────────────
COMPANY_NAME="Acme Inc."

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
