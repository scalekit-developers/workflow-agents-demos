# Scalekit credentials (from your Scalekit workspace dashboard)
SCALEKIT_ENV_URL=https://your-workspace.scalekit.dev
SCALEKIT_CLIENT_ID=skc_...
SCALEKIT_CLIENT_SECRET=test_...

# Your identity per connector -- used as the "identifier" for each connected
# account. DEEL_USER is the identity that has the Deel connection
# authorized (often a People Ops admin, not the employee themselves).
# GOOGLE_CALENDAR_USER and SLACK_USER are usually the employee's own
# identity so their own calendar gets blocked and the Slack search runs
# from an identity that shares a workspace with the manager.
DEEL_USER=admin@yourcompany.com
GOOGLE_CALENDAR_USER=employee@yourcompany.com
SLACK_USER=employee@yourcompany.com

# Connector names -- these are only used for the Step 0 auth-check
# (get_or_create_connected_account) AND to disambiguate execute_tool() calls
# when one identifier is connected to multiple connectors of the same
# provider type. Must match the EXACT connection name shown in your Scalekit
# dashboard under Agent Auth > Connections. Scalekit often auto-suffixes
# these per workspace (e.g. "deelmcp-zTWsHKTh") -- copy the name shown for
# YOUR connection, the defaults below are unlikely to match another
# workspace exactly.
DEEL_CONNECTOR=deelmcp-zTWsHKTh

# Google Calendar connector name as configured in Scalekit (commonly just
# "googlecalendar", not auto-suffixed in most workspaces, but verify with
# list_connected_accounts before assuming).
GOOGLE_CALENDAR_CONNECTOR=googlecalendar

# SlackMCP connector name as configured in Scalekit (e.g. "slackmcp"). The
# plain "SLACK" connector variant commonly sits in PENDING_AUTH and is not
# used by this agent -- its send-message tool has different parameter names
# (channel/text instead of channel_id/message).
SLACK_CONNECTOR=slackmcp

# The employee whose PTO this run is for -- the delegated identity the
# agent acts on behalf of. Must match the email on file in Deel's org chart
# exactly (case-insensitive). If lookup by email is ambiguous or fails for
# any reason, set EMPLOYEE_DEEL_PROFILE_ID below to skip the lookup entirely.
EMPLOYEE_EMAIL=employee@yourcompany.com

# Optional display name used in the calendar event title and Slack message.
# Falls back to the employee's Deel first/last name if left blank, and to
# EMPLOYEE_EMAIL if neither is available.
EMPLOYEE_NAME=

# Optional: the employee's Deel hris_profile_id, if known. Skips the
# org-chart fetch-and-match-by-email lookup in provisioning.py -- there is
# no direct email lookup tool in Deel's catalog, so this is the fastest and
# most reliable path if you already know the ID.
EMPLOYEE_DEEL_PROFILE_ID=

# The manager to notify. MANAGER_EMAIL is resolved to a Slack user ID via
# slackmcp_slack_search_users; set MANAGER_SLACK_ID directly (a raw U...
# Slack user ID) to skip that lookup, e.g. if the manager's Slack profile
# email doesn't match MANAGER_EMAIL.
MANAGER_EMAIL=manager@yourcompany.com
MANAGER_SLACK_ID=

# The leave request itself. Dates are inclusive, YYYY-MM-DD. PTO_TYPE must
# be one of: vacation, sick, personal, bereavement, other -- each maps to a
# real Deel policy_type_name (see config.py's PTO_TYPE_TO_DEEL_POLICY_TYPE).
# The employee must have a matching policy assigned in Deel, or Step 2 will
# fail with a specific message telling you so.
PTO_START_DATE=2026-09-01
PTO_END_DATE=2026-09-03
PTO_TYPE=vacation
PTO_REASON=

# Google Calendar destination for the leave block. "primary" is the
# connected account's own default calendar.
GOOGLE_CALENDAR_ID=primary

# Timing / mode. A leave request is inherently a one-shot action once it
# completes; POLLING_MODE here re-checks whether the CONFIGURED request has
# finished processing yet, rather than resubmitting a completed request on a
# timer (see state.py and run_flow.py).
POLLING_MODE=false
POLL_INTERVAL_MINUTES=15

# Logging
LOG_LEVEL=INFO
